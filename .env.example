# 中央氣象署 (CWA) Open Data API Key
# 請至 https://opendata.cwa.gov.tw/ 申請
VITE_CWA_API_KEY=your_cwa_api_key_here
# Supabase 雲端資料庫設定
# 請至 Supabase 專案後台 (Project Settings -> API) 取得以下資訊：
# 1. Project URL：專案的 REST API 伺服器網址
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# 2. Project API Keys：選擇「anon / public」金鑰 (受 RLS 機制保護，供前端公開存取)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
